# Copie este arquivo para .env.local apenas no seu computador.
# Nunca coloque dados reais neste arquivo.

# Ambiente: development | staging | production
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_ENV_LABEL=Desenvolvimento

# Firebase Web App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lumio-crm-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lumio-crm-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lumio-crm-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin
FIREBASE_ADMIN_PROJECT_ID=lumio-crm-dev
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Admin do sistema
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SECRET=

# Integrações
GOOGLE_MAPS_API_KEY=
