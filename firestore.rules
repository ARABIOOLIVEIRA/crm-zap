rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /empresas/{document} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    match /mensagens/{document} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    match /contatos/{document} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    match /conversas/{document} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    match /followups/{document} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    match /atividades/{document} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    match /listas_prospeccao/{document} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    match /lista_empresas/{document} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    match /configuracoes/{document} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    match /auditoria_administrativa/{document} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    match /rate_limits/{document} {
      allow read, write: if false;
    }
  }
}
